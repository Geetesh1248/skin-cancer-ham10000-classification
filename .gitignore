# ── Raw data (do NOT commit images or the original zip) ──────────────────────
dataset/
archive.zip

# ── Results: large binary feature arrays stay out of git ─────────────────────
# .npz files can be 100s of MB - exclude them
results/*.npz
# label_mapping.json is small and MUST be committed for reproducibility
# (it is NOT excluded - git tracks it by default since only *.npz is ignored)

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
*.whl

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Model artifacts / checkpoints (usually large) ────────────────────────────
# Exclude large binary model files, keep metrics JSONs
models/*.cbm
models/*.txt
models/xgboost_resnet50.json
models/catboost_resnet50.cbm
models/lightgbm_resnet50.txt
# metrics JSONs are small and MUST be committed
# (models/*_metrics.json is NOT excluded)
*.h5
*.pt
*.pth
*.ckpt
*.pkl
*.joblib
catboost_info/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── Secrets / credentials ─────────────────────────────────────────────────────
.env
*.env
secrets.yaml
